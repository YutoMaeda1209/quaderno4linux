// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "Quaderno4Linux",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
